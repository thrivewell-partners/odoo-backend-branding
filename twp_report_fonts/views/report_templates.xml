<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Headings fall back to the text font. With no heading font this adds
         nothing, which the uninstall hook relies on. -->
    <template id="styles_company_report" inherit_id="web.styles_company_report">
        <xpath expr="//t[@t-set='layout']" position="after">
            <t t-if="company.twp_heading_font">
                .o_company_<t t-esc="company.id"/>_layout {
                    h1, h2, h3, h4, h5, h6, .h1, .h2, .h3, .h4, .h5, .h6 {
                        font-family: <t t-esc="company.twp_heading_font"/>, <t t-esc="font"/>;
                    }
                }
            </t>
        </xpath>
    </template>
</odoo>
