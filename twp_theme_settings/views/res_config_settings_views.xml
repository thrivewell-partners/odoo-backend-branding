<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.twp_theme_settings</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Backend Theme" string="Backend Theme" name="twp_theme_settings" logo="/twp_theme_settings/static/description/icon.png" groups="base.group_system">
                    <widget name="twp_theme_preview"/>
                    <block title="Colours and dark mode" name="twp_colors">
                        <div class="col-12 px-3" invisible="not twp_viewing_dark and not (twp_is_staging_copy and twp_staging_marker)">
                            <div class="alert alert-info mb-0" role="status">
                                <div invisible="not twp_viewing_dark">
                                    You are viewing the backend in dark mode, so it shows the
                                    <b>Dark</b> colours. Light colours show in light mode; switch from
                                    your user menu to check them.
                                </div>
                                <div invisible="not twp_is_staging_copy or not twp_staging_marker">
                                    This database is a staging copy, so the navbar shows the staging
                                    colour instead of the navbar colour below. Untick
                                    <b>Mark staging copies</b> to see it here.
                                </div>
                            </div>
                        </div>
                        <setting id="twp_dark_enabled" help="Adds a Dark mode switch to each user's menu.">
                            <field name="twp_dark_enabled"/>
                            <div class="mt-2" invisible="not twp_dark_enabled">
                                <label for="twp_dark_default" class="o_light_label me-2"/>
                                <field name="twp_dark_default" class="w-auto"/>
                            </div>
                        </setting>
                        <setting id="twp_color_primary" string="Primary" help="Buttons, links, active items. Blank follows the navbar colour.">
                            <div class="row mt-2">
                                <span class="col-3 py-1">Light</span>
                                <field name="twp_primary" widget="color" class="col-2 p-0" placeholder="Same as navbar"/>
                                <field name="twp_primary" class="col-4" placeholder="Same as navbar"/>
                            </div>
                            <div class="row mt-1" invisible="not twp_dark_enabled">
                                <span class="col-3 py-1">Dark</span>
                                <field name="twp_dark_primary" widget="color" class="col-2 p-0" placeholder="Automatic"/>
                                <field name="twp_dark_primary" class="col-4" placeholder="Automatic"/>
                            </div>
                        </setting>
                        <setting id="twp_color_navbar" string="Navbar" help="The bar across the top. Blank follows the primary colour.">
                            <div class="row mt-2">
                                <span class="col-3 py-1">Light</span>
                                <field name="twp_navbar" widget="color" class="col-2 p-0" placeholder="Same as primary"/>
                                <field name="twp_navbar" class="col-4" placeholder="Same as primary"/>
                            </div>
                            <div class="row mt-1" invisible="not twp_dark_enabled">
                                <span class="col-3 py-1">Dark</span>
                                <field name="twp_dark_navbar" widget="color" class="col-2 p-0" placeholder="Automatic"/>
                                <field name="twp_dark_navbar" class="col-4" placeholder="Automatic"/>
                            </div>
                        </setting>
                        <setting id="twp_color_success" string="Success" help="Done, paid, confirmed">
                            <div class="row mt-2">
                                <span class="col-3 py-1">Light</span>
                                <field name="twp_success" widget="color" class="col-2 p-0" placeholder="Odoo default"/>
                                <field name="twp_success" class="col-4" placeholder="Odoo default"/>
                            </div>
                            <div class="row mt-1" invisible="not twp_dark_enabled">
                                <span class="col-3 py-1">Dark</span>
                                <field name="twp_dark_success" widget="color" class="col-2 p-0" placeholder="Automatic"/>
                                <field name="twp_dark_success" class="col-4" placeholder="Automatic"/>
                            </div>
                        </setting>
                        <setting id="twp_color_info" string="Info" help="Notes and neutral tags">
                            <div class="row mt-2">
                                <span class="col-3 py-1">Light</span>
                                <field name="twp_info" widget="color" class="col-2 p-0" placeholder="Odoo default"/>
                                <field name="twp_info" class="col-4" placeholder="Odoo default"/>
                            </div>
                            <div class="row mt-1" invisible="not twp_dark_enabled">
                                <span class="col-3 py-1">Dark</span>
                                <field name="twp_dark_info" widget="color" class="col-2 p-0" placeholder="Automatic"/>
                                <field name="twp_dark_info" class="col-4" placeholder="Automatic"/>
                            </div>
                        </setting>
                        <setting id="twp_color_warning" string="Warning" help="Needs attention">
                            <div class="row mt-2">
                                <span class="col-3 py-1">Light</span>
                                <field name="twp_warning" widget="color" class="col-2 p-0" placeholder="Odoo default"/>
                                <field name="twp_warning" class="col-4" placeholder="Odoo default"/>
                            </div>
                            <div class="row mt-1" invisible="not twp_dark_enabled">
                                <span class="col-3 py-1">Dark</span>
                                <field name="twp_dark_warning" widget="color" class="col-2 p-0" placeholder="Automatic"/>
                                <field name="twp_dark_warning" class="col-4" placeholder="Automatic"/>
                            </div>
                        </setting>
                        <setting id="twp_color_danger" string="Danger" help="Errors, overdue, delete">
                            <div class="row mt-2">
                                <span class="col-3 py-1">Light</span>
                                <field name="twp_danger" widget="color" class="col-2 p-0" placeholder="Odoo default"/>
                                <field name="twp_danger" class="col-4" placeholder="Odoo default"/>
                            </div>
                            <div class="row mt-1" invisible="not twp_dark_enabled">
                                <span class="col-3 py-1">Dark</span>
                                <field name="twp_dark_danger" widget="color" class="col-2 p-0" placeholder="Automatic"/>
                                <field name="twp_dark_danger" class="col-4" placeholder="Automatic"/>
                            </div>
                        </setting>
                        <setting id="twp_color_bg" string="Page background" help="Behind lists and forms">
                            <div class="row mt-2">
                                <span class="col-3 py-1">Light</span>
                                <field name="twp_bg" widget="color" class="col-2 p-0" placeholder="Odoo default"/>
                                <field name="twp_bg" class="col-4" placeholder="Odoo default"/>
                            </div>
                            <div class="row mt-1" invisible="not twp_dark_enabled">
                                <span class="col-3 py-1">Dark</span>
                                <field name="twp_dark_bg" widget="color" class="col-2 p-0" placeholder="Automatic"/>
                                <field name="twp_dark_bg" class="col-4" placeholder="Automatic"/>
                            </div>
                        </setting>
                        <setting id="twp_color_view" string="Sheets" help="Forms, lists, cards and the bar under the navbar. Tabs, borders and grey buttons are worked out from this and the text colour.">
                            <div class="row mt-2">
                                <span class="col-3 py-1">Light</span>
                                <field name="twp_view" widget="color" class="col-2 p-0" placeholder="Odoo default"/>
                                <field name="twp_view" class="col-4" placeholder="Odoo default"/>
                            </div>
                            <div class="row mt-1" invisible="not twp_dark_enabled">
                                <span class="col-3 py-1">Dark</span>
                                <field name="twp_dark_view" widget="color" class="col-2 p-0" placeholder="Automatic"/>
                                <field name="twp_dark_view" class="col-4" placeholder="Automatic"/>
                            </div>
                        </setting>
                        <setting id="twp_color_text" string="Text" help="Body text. Blank picks dark or light text to suit the sheets.">
                            <div class="row mt-2">
                                <span class="col-3 py-1">Light</span>
                                <field name="twp_text" widget="color" class="col-2 p-0" placeholder="Automatic"/>
                                <field name="twp_text" class="col-4" placeholder="Automatic"/>
                            </div>
                            <div class="row mt-1" invisible="not twp_dark_enabled">
                                <span class="col-3 py-1">Dark</span>
                                <field name="twp_dark_text" widget="color" class="col-2 p-0" placeholder="Automatic"/>
                                <field name="twp_dark_text" class="col-4" placeholder="Automatic"/>
                            </div>
                        </setting>
                    </block>
                    <block title="Typography and shape" name="twp_type">
                        <setting id="twp_font_body" string="Body font" help="Any Google Font, by its family name. Blank keeps Odoo's default. Downloaded once when you save and served from this database.">
                            <field name="twp_font_body" placeholder="Odoo default"/>
                        </setting>
                        <setting id="twp_font_head" string="Heading font" help="Titles, section headings, breadcrumbs. Blank matches the body font.">
                            <field name="twp_font_head" placeholder="Same as body"/>
                        </setting>
                        <setting id="twp_font_size" string="Base font size" help="Odoo's default is 14px.">
                            <field name="twp_font_size" class="w-auto"/>
                        </setting>
                        <setting id="twp_radius" string="Corner radius" help="Buttons, inputs and cards. Odoo's default is 4px.">
                            <field name="twp_radius" class="w-auto"/>
                        </setting>
                        <setting id="twp_density" string="Density" help="Compact fits more list rows and form fields on screen.">
                            <field name="twp_density" class="w-auto"/>
                        </setting>
                    </block>
                    <block title="Layout" name="twp_layout">
                        <setting id="twp_sheet_width" string="Form width" help="How wide a record's sheet grows on a large screen. Normal is Odoo's 1400px, wide is 1800px.">
                            <field name="twp_sheet_width" class="w-auto"/>
                        </setting>
                    </block>
                    <block title="Login page" name="twp_login">
                        <setting id="twp_login_enabled" help="Your logo, colours and fonts on the login page, instead of Odoo's or the website's. Applies to everyone; no company is chosen before login.">
                            <field name="twp_login_enabled"/>
                            <div class="mt-3" invisible="not twp_login_enabled">
                                <div class="row">
                                    <label for="twp_login_layout" class="col-4 o_light_label"/>
                                    <field name="twp_login_layout" class="col-6 w-auto"/>
                                </div>
                                <div class="row mt-2">
                                    <label for="twp_login_heading" class="col-4 o_light_label" string="Heading"/>
                                    <field name="twp_login_heading" class="col-8" placeholder="Welcome back"/>
                                </div>
                                <div class="row mt-2">
                                    <label for="twp_login_tagline" class="col-4 o_light_label" string="Tagline"/>
                                    <field name="twp_login_tagline" class="col-8" placeholder="Optional line under the heading"/>
                                </div>
                                <div class="row mt-2">
                                    <span class="col-4 py-1 o_light_label">Background</span>
                                    <field name="twp_login_bg" widget="color" class="col-2 p-0" placeholder="Same as navbar"/>
                                    <field name="twp_login_bg" class="col-4" placeholder="Same as navbar"/>
                                </div>
                            </div>
                        </setting>
                        <setting id="twp_login_images" string="Login images" help="Logo blank uses the company logo. A background image covers the background colour; in split screen it fills the left half." invisible="not twp_login_enabled">
                            <div class="row mt-2">
                                <span class="col-4 o_light_label">Logo</span>
                                <field name="twp_login_logo" widget="image" class="col-8" options="{'size': [0, 64]}"/>
                            </div>
                            <div class="row mt-2">
                                <span class="col-4 o_light_label">Background image</span>
                                <field name="twp_login_background" widget="image" class="col-8" options="{'size': [0, 96]}"/>
                            </div>
                        </setting>
                    </block>
                    <block title="Staging copies" name="twp_staging">
                        <setting id="twp_staging_marker" help="On a neutralized copy, recolour the navbar and label it STAGING.">
                            <field name="twp_staging_marker"/>
                            <div class="row mt-2" invisible="not twp_staging_marker">
                                <span class="col-3 py-1">Colour</span>
                                <field name="twp_staging_color" widget="color" class="col-2 p-0"/>
                                <field name="twp_staging_color" class="col-4" placeholder="#B7472A"/>
                            </div>
                        </setting>
                    </block>
                    <block title="Copy and reset" name="twp_copy">
                        <setting id="twp_export_look" string="Download the look" help="The saved colours, fonts, shape, layout and login page as a file, to load into another database. Save your changes first.">
                            <button name="action_twp_export_look" type="object" string="Download" class="btn-link" icon="fa-download"/>
                        </setting>
                        <setting id="twp_import_look" string="Load a look" help="Replace this look with one downloaded from another database. Company colours and logos are kept.">
                            <button name="action_twp_import_look" type="object" string="Load from a file" class="btn-link" icon="fa-upload"/>
                        </setting>
                        <setting id="twp_reset" string="Reset" help="Back to Odoo's colours, fonts, shape, layout and login page. Company colours and logos are kept.">
                            <button name="action_twp_reset_theme" type="object" string="Reset to Odoo defaults" class="btn-link" icon="oi-arrow-right" confirm="Reset the backend theme to Odoo's defaults?"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
